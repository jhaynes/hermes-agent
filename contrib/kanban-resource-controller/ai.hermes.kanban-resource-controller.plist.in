<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.hermes.kanban-resource-controller</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/retained-hermes-source/venv/bin/python</string>
    <string>-B</string>
    <string>/ABSOLUTE/PATH/TO/operations/kanban-resource-controller/controller.py</string>
    <string>--config</string>
    <string>/ABSOLUTE/PATH/TO/operations/kanban-resource-controller/controller.json</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/operations/kanban-resource-controller</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Nice</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key><dict>
    <key>OMP_NUM_THREADS</key><string>1</string>
    <key>OPENBLAS_NUM_THREADS</key><string>1</string>
    <key>MKL_NUM_THREADS</key><string>1</string>
    <key>VECLIB_MAXIMUM_THREADS</key><string>1</string>
    <key>NUMEXPR_NUM_THREADS</key><string>1</string>
  </dict>
  <!-- Application status + rotated events.log are the bounded diagnostic sink. -->
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
